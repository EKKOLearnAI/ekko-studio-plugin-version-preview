    "tagPackage": {
      "type": "object",
      "description": "Tag 指向的源码根 package.json，用于区分 Studio 与 App 发布；允许上游其他字段。",
      "properties": {
        "name": { "type": "string", "description": "源码包名；Studio 允许 ekko-studio 或 hermes-web-ui。" },
        "version": { "type": "string", "description": "源码 Studio/Web UI 版本，必须与 Tag 去掉 v 后一致。" }
      },
      "required": ["name", "version"],
      "additionalProperties": true
    },
    "tags": {
      "type": "object",
      "description": "main 加最多八个经源码版本校验的 Studio/Web UI tag；排除版本号不匹配的 Android/App tag。",
      "properties": {
        "tags": {
          "type": "array",
          "description": "按 Studio/Web UI 版本倒序排列，Tag 去掉 v 后必须与根 package.json 的版本一致。",
          "maxItems": 9,
          "items": {
            "type": "object",
            "description": "Git ref。",
            "properties": {
              "name": {
                "type": "string",
                "description": "main 或版本 tag。"
              },
              "sha": {
                "type": "string",
                "description": "Git SHA；main/归档未知时为空。"
              }
            },
            "required": [
              "name",
              "sha"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tags"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "description": "runner.json v1；不存在可选字段表示无当前作业或进程。",
      "properties": {
        "version": {
          "type": "integer",
          "description": "状态结构版本。",
          "enum": [
            1
          ]
        },
        "active": {
          "type": "object",
          "description": "作业记录。",
          "properties": {
            "id": {
              "type": "string",
              "description": "随机作业 ID。"
            },
            "name": {
              "type": "string",
              "description": "操作名称。"
            },
            "startedAt": {
              "type": "string",
              "description": "ISO 开始时间。"
            },
            "success": {
              "type": "boolean",
              "description": "完成结果。"
            },
            "message": {
              "type": "string",
              "description": "完成信息。"
            },
            "code": {
              "type": "string",
              "description": "结果代码。"
            },
            "completedAt": {
              "type": "string",
              "description": "ISO 完成时间。"
            }
          },
          "required": [
            "id",
            "name",
            "startedAt"
          ],
          "additionalProperties": false
        },
        "last": {
          "type": "object",
          "description": "作业记录。",
          "properties": {
            "id": {
              "type": "string",
              "description": "随机作业 ID。"
            },
            "name": {
              "type": "string",
              "description": "操作名称。"
            },
            "startedAt": {
              "type": "string",
              "description": "ISO 开始时间。"
            },
            "success": {
              "type": "boolean",
              "description": "完成结果。"
            },
            "message": {
              "type": "string",
              "description": "完成信息。"
            },
            "code": {
              "type": "string",
              "description": "结果代码。"
            },
            "completedAt": {
              "type": "string",
              "description": "ISO 完成时间。"
            }
          },
          "required": [
            "id",
            "name",
            "startedAt"
          ],
          "additionalProperties": false
        },
        "process": {
          "type": "object",
          "description": "受控独立进程组身份。",
          "properties": {
            "pid": {
              "type": "integer",
              "description": "进程组根 PID。",
              "minimum": 1
            },
            "fingerprint": {
              "type": "string",
              "description": "系统进程创建时间，用于拒绝 PID 复用。"
            },
            "sourceDir": {
              "type": "string",
              "description": "对应源码目录。"
            }
          },
          "required": [
            "pid",
            "fingerprint",
            "sourceDir"
          ],
          "additionalProperties": false
        },
        "backups": {
          "type": "array",
          "description": "保留的旧源码目录；插件从不自动删除。",
          "items": {
            "type": "string",
            "description": "备份目录绝对路径。"
          }
        },
        "ports": {
          "type": "object",
          "description": "插件自动分配并在重载后复用的预览端口。",
          "properties": {
            "frontendPort": {
              "type": "integer",
              "description": "前端端口。",
              "minimum": 1024,
              "maximum": 65535
            },
            "backendPort": {
              "type": "integer",
              "description": "后端端口。",
              "minimum": 1024,
              "maximum": 65535
            },
            "bridgePort": {
              "type": "integer",
              "description": "Agent bridge端口。",
              "minimum": 1024,
              "maximum": 65535
            },
            "workerPortBase": {
              "type": "integer",
              "description": "隔离的 worker 端口段起点端口。",
              "minimum": 1024,
              "maximum": 65535
            }
          },
          "required": [
            "frontendPort",
            "backendPort",
            "bridgePort",
            "workerPortBase"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "backups"
      ],
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "description": "本插件原子所有权锁文件。",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "description": "拥有锁的宿主进程 PID。"
        },
        "fingerprint": {
          "type": "string",
          "description": "宿主进程创建时间。"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "description": "随机所有权标识。"
        }
      },
      "required": [
        "pid",
        "fingerprint",
        "token"
      ],
      "additionalProperties": false
    },
    "instanceSlot": {
      "type": "object",
      "description": "稳定宿主实例的独立存储及端口段分配；每个槽位单独原子创建。",
      "properties": {
        "version": {
          "type": "integer",
          "description": "分配记录版本。",
          "enum": [
            1
          ]
        },
        "instanceKey": {
          "type": "string",
          "description": "由当前进程运行环境导出的稳定实例摘要，不含用户或认证信息。",
          "minLength": 16,
          "maxLength": 16
        }
