    "tags": {
      "type": "object",
      "description": "main 加最多八个版本 tag。",
      "properties": {
        "tags": {
          "type": "array",
          "description": "按版本倒序排列。",
          "maxItems": 9,
          "items": {
            "type": "object",
            "description": "Git ref。",
            "properties": {
              "name": {
                "type": "string",
                "description": "main 或版本 tag。"
              },
              "sha": {
                "type": "string",
                "description": "Git SHA；main/归档未知时为空。"
              }
            },
            "required": ["name", "sha"],
            "additionalProperties": false
          }
        }
      },
      "required": ["tags"],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "description": "runner.json v1；不存在可选字段表示无当前作业或进程。",
      "properties": {
        "version": {
          "type": "integer",
          "description": "状态结构版本。",
          "enum": [1]
        },
        "active": {
          "type": "object",
          "description": "作业记录。",
          "properties": {
            "id": {
              "type": "string",
              "description": "随机作业 ID。"
            },
            "name": {
              "type": "string",
              "description": "操作名称。"
            },
            "startedAt": {
              "type": "string",
              "description": "ISO 开始时间。"
            },
            "success": {
              "type": "boolean",
              "description": "完成结果。"
            },
            "message": {
              "type": "string",
              "description": "完成信息。"
            },
            "code": {
              "type": "string",
              "description": "结果代码。"
            },
            "completedAt": {
              "type": "string",
              "description": "ISO 完成时间。"
            }
          },
          "required": ["id", "name", "startedAt"],
          "additionalProperties": false
        },
        "last": {
          "type": "object",
          "description": "作业记录。",
          "properties": {
            "id": {
              "type": "string",
              "description": "随机作业 ID。"
            },
            "name": {
              "type": "string",
              "description": "操作名称。"
            },
            "startedAt": {
              "type": "string",
              "description": "ISO 开始时间。"
            },
            "success": {
              "type": "boolean",
              "description": "完成结果。"
            },
            "message": {
              "type": "string",
              "description": "完成信息。"
            },
            "code": {
              "type": "string",
              "description": "结果代码。"
            },
            "completedAt": {
              "type": "string",
              "description": "ISO 完成时间。"
            }
          },
          "required": ["id", "name", "startedAt"],
          "additionalProperties": false
        },
        "process": {
          "type": "object",
          "description": "受控独立进程组身份。",
          "properties": {
            "pid": {
              "type": "integer",
              "description": "进程组根 PID。",
              "minimum": 1
            },
            "fingerprint": {
              "type": "string",
              "description": "系统进程创建时间，用于拒绝 PID 复用。"
            },
            "sourceDir": {
              "type": "string",
              "description": "对应源码目录。"
            }
          },
          "required": ["pid", "fingerprint", "sourceDir"],
          "additionalProperties": false
        },
        "backups": {
          "type": "array",
          "description": "保留的旧源码目录；插件从不自动删除。",
          "items": {
            "type": "string",
            "description": "备份目录绝对路径。"
          }
        }
      },
      "required": ["version", "backups"],
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "description": "公开宿主资源租约提供的历史目录；只读元数据。",
      "properties": {
        "sourceDir": {
          "type": "string",
          "description": "历史源码目录绝对路径。"
        },
        "homeDir": {
          "type": "string",
          "description": "历史预览 Web UI 数据目录绝对路径。"
        }
      },
      "required": ["sourceDir", "homeDir"],
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "description": "本插件原子所有权锁文件。",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "description": "拥有锁的宿主进程 PID。"
        },
        "fingerprint": {
          "type": "string",
          "description": "宿主进程创建时间。"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "description": "随机所有权标识。"
        }
      },
      "required": ["pid", "fingerprint", "token"],
      "additionalProperties": false
    }
  },
  "rpc": {
    "status": {
      "description": "读取状态与有界日志；无需管理员身份。",
      "input": "empty",
      "output": "status"
    },
    "tags": {
      "description": "Git 远端标签，失败回退 GitHub API；缓存五分钟。",
      "input": "empty",
      "output": "tags"
    },
    "prepare": {
      "description": "先暂存下载再备份切换，复用预览数据。",
      "input": "ref",
      "output": "accepted"
    },
    "install": {
      "description": "安装开发依赖并 rebuild node-pty；最长二十分钟。",
      "input": "empty",
      "output": "accepted"
    },
    "start": {
      "description": "启动独立预览；前后端均响应后成功。",
      "input": "start",
      "output": "accepted"
    },
    "stop": {
      "description": "取消长任务并清理所有已归属进程。",
      "input": "empty",
      "output": "stopped"
    },
    "cancel": {
      "description": "取消操作等价 stop，等待清理完成。",
      "input": "empty",
      "output": "stopped"
    },
    "adopt": {
      "description": "显式交接 Unix 旧预览进程；无法核验归属时拒绝。",
      "input": "adopt",
      "output": "accepted"
    }
  },
  "tools": {},
  "commands": {},
  "actions": {},
  "events": {},
  "storage": {
    "runner": {
      "description": "插件 dataDir/runner.json；刷新、升级、停用均保留。",
      "model": "state",
      "version": 1,
      "scope": "ctx.paths.dataDir"
    }
  },
  "checkpoints": {}
}
