{
  "id": "version-preview",
  "name": "Version Preview",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "Preview Studio versions with isolated source, data and services.",
  "repository": "https://github.com/EKKOLearnAI/ekko-studio-plugin-version-preview",
  "license": "MIT",
  "server": "server.mjs",
  "client": "client.mjs",
  "permissions": [
    "ui"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "repository": {
        "type": "string",
        "description": "要预览的 GitHub 仓库；留空使用可选宿主元数据或官方 Studio 仓库。",
        "default": ""
      },
      "nodePath": {
        "type": "string",
        "description": "独立 Node 可执行文件绝对路径；留空自动探测。",
        "default": ""
      },
      "npmCliPath": {
        "type": "string",
        "description": "npm-cli.js 绝对路径；留空自动探测。",
        "default": ""
      },
      "frontendPort": {
        "type": "integer",
        "description": "预览前端端口。 0 表示由插件自动分配；非零为高级固定端口覆盖。",
        "minimum": 0,
        "maximum": 65535,
        "default": 0
      },
      "backendPort": {
        "type": "integer",
        "description": "预览后端端口。 0 表示由插件自动分配；非零为高级固定端口覆盖。",
        "minimum": 0,
        "maximum": 65535,
        "default": 0
      },
      "bridgePort": {
        "type": "integer",
        "description": "TCP bridge 端口。 0 表示由插件自动分配；非零为高级固定端口覆盖。",
        "minimum": 0,
        "maximum": 65535,
        "default": 0
      },
      "workerPortBase": {
        "type": "integer",
        "description": "Bridge worker 起始端口。 0 表示由插件自动分配；非零为高级固定端口覆盖。",
        "minimum": 0,
        "maximum": 64500,
        "default": 0
      },
      "bridgeTransport": {
        "type": "string",
        "description": "Agent bridge 传输方式。",
        "enum": [
          "auto",
          "tcp",
          "ipc"
        ],
        "default": "auto"
      },
      "frontendOrigin": {
        "type": "string",
        "description": "远程反向代理预览入口；留空使用浏览器所在主机及前端端口。",
        "default": ""
      }
    },
    "additionalProperties": false
  },
  "views": [
    {
      "id": "preview",
      "title": "Version Preview",
      "slot": "settings",
      "icon": "assets/logo.png"
    }
  ],
  "navigation": {
    "settings": [
      {
        "viewId": "preview",
        "icon": "assets/logo.png",
        "order": 90
      }
    ]
  },
  "i18n": {
    "en": {
      "name": "Version Preview",
      "description": "Preview Studio versions with isolated source, data and services.",
      "views": {
        "preview": "Version Preview"
      }
    },
    "zh": {
      "name": "版本预览",
      "description": "独立预览 Studio 版本，自动管理源码、数据目录与运行服务。",
      "views": {
        "preview": "版本预览"
      }
    }
  },
  "icon": "assets/logo.png"
}
